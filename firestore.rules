rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The dashboard is read-only. Only the accounts listed below can read; add a
    // friend by adding their Gmail address here AND to allowedEmails in
    // dashboard/src/environments/environment.ts, then deploy with
    // `firebase deploy --only firestore`. The bots write with a service account,
    // which bypasses these rules.
    match /{document=**} {
      allow read: if request.auth != null
                  && request.auth.token.email.lower() in ['m.tanveer.shaikh@gmail.com', 'gulfam886@gmail.com', 'er.waseemhyder@gmail.com', 'wasif.fmukadam@gmail.com', 'herman.shafiq@gmail.com']
                  && request.auth.token.email_verified == true;
      allow write: if false;
    }
  }
}
